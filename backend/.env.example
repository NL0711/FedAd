# Copy to .env (git-ignored) and fill in. Values here are placeholders, never real secrets.

# Supabase project (ref ystailcfsejrtmivhulc). Session pooler string; replace [YOUR-DATABASE-PASSWORD] with the database password you set in
# Supabase (Project Settings > Database). Set the real value only in .env or as a Render environment variable, never in a committed file.
DATABASE_URL=postgresql://postgres.ystailcfsejrtmivhulc:[YOUR-DATABASE-PASSWORD]@aws-0-ap-southeast-2.pooler.supabase.com:5432/postgres

# Supabase Auth: the backend verifies each sign-in token against this project's public keys (no secret needed).
SUPABASE_URL=https://ystailcfsejrtmivhulc.supabase.co
# Publishable key, Project Settings > API Keys. The sign-in pages use it; it is safe to expose and the backend does not need it.
# Never put the secret key (sb_secret_...) anywhere in this project.
SUPABASE_PUBLISHABLE_KEY=

# Minimum people in a group before the advertiser console shows it.
FEDAD_MIN_COHORT=10
