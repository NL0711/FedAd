# Copy to .env (git-ignored) and fill in. Values here are placeholders, never real secrets.

# Supabase project (ref vtwufwokgahgogfdtcrq). The password is the database password you set in Supabase: Project Settings > Database.
DATABASE_URL=postgresql://postgres:[YOUR-DATABASE-PASSWORD]@db.vtwufwokgahgogfdtcrq.supabase.co:5432/postgres

# Supabase Auth: the backend verifies each sign-in token against this project's public keys (no secret needed).
SUPABASE_URL=https://vtwufwokgahgogfdtcrq.supabase.co
# Publishable key, Project Settings > API Keys. The sign-in pages use it; it is safe to expose and the backend does not need it.
# Never put the secret key (sb_secret_...) anywhere in this project.
SUPABASE_PUBLISHABLE_KEY=

# Minimum people in a group before the advertiser console shows it.
FEDAD_MIN_COHORT=10
