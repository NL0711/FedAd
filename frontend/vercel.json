{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/", "destination": "/store.html" },
    { "source": "/api/:path*", "destination": "https://fedad.onrender.com/api/:path*" },
    { "source": "/auth/:path*", "destination": "https://fedad.onrender.com/auth/:path*" },
    { "source": "/v1/:path*", "destination": "https://fedad.onrender.com/v1/:path*" },
    { "source": "/figures/:path*", "destination": "https://fedad.onrender.com/figures/:path*" }
  ]
}
