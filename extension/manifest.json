{
  "manifest_version": 3,
  "name": "FedAd Contributor",
  "version": "0.2.0",
  "description": "Watches your activity on the FedAd demo shop (the one site you join) and contributes a clipped, noised model update. No browsing history is read.",
  "permissions": ["storage", "scripting"],
  "optional_host_permissions": ["https://*/*", "http://*/*"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "FedAd Contributor" },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'self'" },
  "icons": { "128": "icon.png" }
}
